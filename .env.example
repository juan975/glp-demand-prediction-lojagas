# Copiar a .env y completar. .env NO se versiona.

# Servidor: /srv/lojagas. Desarrollo en WSL: /home/<usuario>/lojagas_datos (nunca /mnt/c/)
LOJAGAS_DATA_ROOT=/srv/lojagas

# --- Versiones de imágenes ---
# Verificar el tag en hub.docker.com/r/apache/airflow antes de fijarlo
AIRFLOW_VERSION=3.3.2
# Lo fija `make build` con el SHA del commit; los DAGs lanzan esta etiqueta
LOJAGAS_IMAGE_TAG=dev

# --- PostgreSQL (único motor: db_airflow y db_mlflow) ---
POSTGRES_USER=lojagas
POSTGRES_PASSWORD=cambiar
AIRFLOW_DB_PASSWORD=cambiar
MLFLOW_DB_PASSWORD=cambiar

# --- Airflow ---
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Generar: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AIRFLOW_JWT_SECRET=
# Desarrollo (Linux/WSL): el resultado de `id -u` (normalmente 1000)
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambiar

# --- Odoo (en la nube, ingesta por API) ---
ODOO_URL=https://odoo.lojagas.example
ODOO_DB=lojagas
ODOO_API_KEY=cambiar

# --- Tablero de consulta (ADR-0012: acceso por segmentación de red) ---
# Desarrollo: 127.0.0.1
LOJAGAS_LAN_IP=192.168.0.10
LOJAGAS_INTERFAZ_PUERTO=8000

# --- Anonimización (sal del HMAC; si se pierde, no se pueden unir corridas) ---
# Generar igual que el JWT. Guardarla fuera del servidor: si se pierde, no se pueden unir corridas
LOJAGAS_PII_SALT=
